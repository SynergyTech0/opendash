<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- OpenDash targets Android Automotive OS head units. required="false" so
         it also installs on a phone/tablet or the automotive emulator for
         development. Set required="true" for an AAOS-only release. -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="false" />

    <!-- Touch head units aren't required to have these; declare them optional. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenDash">

        <!-- Declares this as an Automotive app; the XML can carry media/templates
             metadata for a production app. -->
        <meta-data
            android:name="com.android.automotive"
            android:resource="@xml/automotive_app_desc" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.OpenDash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
